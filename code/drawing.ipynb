import tensorflow as tf
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error

COORD_CSV = "/home/oem/py/p_train/handwriting_custom_standard.csv"  # 你的修复后CSV路径
CLASSES = ['J', 'O', 'B', '!']
COORD_POINTS = 30
TRAIN_RATIO = 0.8

def load_dataset():
    df = pd.read_csv(COORD_CSV, encoding='utf-8-sig')
    # 读取独热编码
    inputs = np.array([np.array(row['独热编码'].split(','), dtype=np.float32) for idx, row in df.iterrows()])
    # 读取坐标（x1-y30）
    coord_cols = [f'x{i+1}' for i in range(COORD_POINTS)] + [f'y{i+1}' for i in range(COORD_POINTS)]
    outputs = np.array([row[coord_cols].values.astype(np.float32) for idx, row in df.iterrows()])
    # 坐标归一化（关键：缩放到0-1）
    scaler = StandardScaler()
    outputs = scaler.fit_transform(outputs)
    # 分层划分训练/验证集
    class_list = df['类别'].tolist()
    X_train, X_val, y_train, y_val = train_test_split(
        inputs, outputs, test_size=1-TRAIN_RATIO, random_state=42, stratify=class_list
    )
    return X_train, X_val, y_train, y_val, scaler, df

# 加载数据
X_train, X_val, y_train, y_val, coord_scaler, df = load_dataset()
print(f"训练集：输入{X_train.shape}，输出{y_train.shape}")
print(f"验证集：输入{X_val.shape}，输出{y_val.shape}")


def build_strong_model():
    """
    ✅ 改进点：
    - 增加网络深度+宽度，提升拟合能力
    - 加入BatchNorm稳定训练
    - 加入Dropout+L2正则，防止过拟合
    """
    model = tf.keras.Sequential([
        # 输入层
        tf.keras.layers.Input(shape=(4,)),
        
        # 隐藏层（加深+加宽+正则）
        tf.keras.layers.Dense(512, activation='relu', kernel_regularizer=tf.keras.regularizers.l2(0.001)),
        tf.keras.layers.BatchNormalization(),
        tf.keras.layers.Dropout(0.3),
        
        tf.keras.layers.Dense(256, activation='relu', kernel_regularizer=tf.keras.regularizers.l2(0.001)),
        tf.keras.layers.BatchNormalization(),
        tf.keras.layers.Dropout(0.2),
        
        tf.keras.layers.Dense(128, activation='relu', kernel_regularizer=tf.keras.regularizers.l2(0.001)),
        tf.keras.layers.BatchNormalization(),
        tf.keras.layers.Dropout(0.1),
        
        # 输出层（线性激活，回归任务）
        tf.keras.layers.Dense(60, activation='linear')
    ])
    
    # 编译：用AdamW优化器（比Adam更稳），MAE+MSE双损失
    model.compile(
        optimizer=tf.keras.optimizers.AdamW(learning_rate=0.0005, weight_decay=0.001),
        loss='mean_squared_error',
        metrics=['mean_absolute_error']
    )
    return model

# 构建模型
model = build_strong_model()
model.summary()


      
early_stopping = tf.keras.callbacks.EarlyStopping(
    monitor='val_loss', patience=20, restore_best_weights=True
)
# 学习率调度：训练后期降低学习率，精细拟合
lr_scheduler = tf.keras.callbacks.ReduceLROnPlateau(
    monitor='val_loss', factor=0.5, patience=10, min_lr=1e-6
)

# 训练模型
history = model.fit(
    X_train, y_train,
    validation_data=(X_val, y_val),
    epochs=60,  # 增加训练轮数
    batch_size=8,  # 减小批次，提升拟合精度
    callbacks=[early_stopping, lr_scheduler],
    verbose=1
)




plt.figure(figsize=(12, 4))
# 损失曲线
plt.subplot(1, 2, 1)
plt.plot(history.history['loss'], label='训练损失')
plt.plot(history.history['val_loss'], label='验证损失')
plt.title('model loss(MSE)')
plt.xlabel('Epoch')
plt.ylabel('Loss')
plt.legend()
plt.grid(True)

# MAE曲线
plt.subplot(1, 2, 2)
plt.plot(history.history['mean_absolute_error'], label='traing_MAE')
plt.plot(history.history['val_mean_absolute_error'], label='val_MAE')
plt.title('absoluate average loss(MAE)')
plt.xlabel('Epoch')
plt.ylabel('MAE')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()






def predict_and_plot_final(class_name):
    """
    预测并可视化指定类别的轨迹（反归一化，恢复真实坐标）
    """
    # 生成独热编码
    class_idx = CLASSES.index(class_name)
    one_hot = np.eye(4)[class_idx].reshape(1, -1)
    
    # 预测（归一化坐标）
    pred_norm = model.predict(one_hot, verbose=0)
    # 反归一化，恢复原始坐标
    pred_coords = coord_scaler.inverse_transform(pred_norm)[0]
    
    # 拆分x/y
    x = pred_coords[:30]
    y = pred_coords[30:]
    
    # 可视化
    plt.figure(figsize=(3,3))
    plt.plot(x, y, 'b-', label=f'{class_name} 预测轨迹')
    plt.scatter(x, y, c=range(30), cmap='viridis', s=20)
    plt.colorbar(label='sequence(0=the under)')
    plt.title(f'{class_name} predict_contour(after tarining）')
    plt.axis('equal')
    plt.grid(True)
    plt.legend()
    plt.show()
    
    # 打印坐标统计
    print(f"{class_name} 轨迹坐标统计：")
    print(f"X范围：{np.min(x):.1f} ~ {np.max(x):.1f}")
    print(f"Y范围：{np.min(y):.1f} ~ {np.max(y):.1f}")

# 测试四类轨迹
for cls in CLASSES:
    predict_and_plot_final(cls)


import pickle

# 保存训练时的坐标归一化器（必须和训练用同一个！）
scaler_path = "./coord_scaler.pkl"
with open(scaler_path, 'wb') as f:
    pickle.dump(coord_scaler, f)

print(f"✅ 训练时的scaler已保存到：{scaler_path}")
model.save("contour_model.h5")
print("✅ 模型保存成功！")
