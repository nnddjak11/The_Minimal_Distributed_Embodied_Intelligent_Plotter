def audio_augmentation(y, sr, label=None):
    """新增label参数，给J类单独增强"""
    # 1. 基础增强（所有类别）
    noise = np.random.randn(len(y)) * random.uniform(0, 0.003)
    y = y + noise
    rate = random.uniform(0.9, 1.1)
    y = librosa.effects.time_stretch(y, rate=rate)
    
    # 2. 🔥 J类专属增强：突出高频擦音（J的核心特征，B没有）
    if label == 'J':
        # 提升高频（2000-8000Hz），强化J的擦音
        y = librosa.effects.preemphasis(y, coef=0.98)
        # 轻微提升音量，避免被B的特征盖过
        y = y * random.uniform(1.1, 1.3)
    
    # 3. B类增强：弱化高频，突出爆破音（和J区分）
    if label == 'B':
        # 降低高频，强化B的低频爆破特征
        y = librosa.effects.lowpass_filter(y, sr=sr, cutoff=1500)
    
    return y


def load_audio_mfcc(file_path, augment=False):
    y, sr = librosa.load(file_path, sr=SAMPLE_RATE)
    
    # 🔥 核心修改1：完全删除填充静音到2s的逻辑，保留原始时长
    # 只截断超长音频（如果有超过2s的才截，你这里没有，所以这行可删）
    # if len(y) > SAMPLE_RATE * DURATION:
    #     y = y[:SAMPLE_RATE * DURATION]
    
    # 数据增强（仅训练时用）
    if augment:
        y = audio_augmentation(y, sr)
    
    # 🔥 核心修改2：提取MFCC时，用原始时长，不强制2s
    mfcc = librosa.feature.mfcc(
        y=y,
        sr=SAMPLE_RATE,
        n_mfcc=N_MFCC,
        hop_length=128,  # 减小步长，捕捉更多J的细节特征
        n_fft=512        # 减小FFT窗口，适配短音频
    )
    mfcc = mfcc.T  # (timesteps, n_mfcc)
    
    # 🔥 核心修改3：统一时序长度，但用边缘插值（不是填充静音）
    # MAX_TIMESTEPS可以降到50（适配短音频，你原来的100太长）
    MAX_TIMESTEPS = 50
    if len(mfcc) < MAX_TIMESTEPS:
        # 用边缘值插值，保留J的核心特征，不是填0（静音）
        mfcc = librosa.util.fix_length(mfcc.T, size=MAX_TIMESTEPS, mode='edge').T
    else:
        mfcc = mfcc[:MAX_TIMESTEPS]  # 超长才截断
    
    return mfcc



