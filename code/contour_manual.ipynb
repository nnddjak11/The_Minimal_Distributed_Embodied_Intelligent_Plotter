import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# 完全匹配你手绘的4类标准轨迹（30个点，严格对齐start/end/形状）
def get_custom_standard_trajectories():
    """
    1:1还原你的手绘：
    - J：start底部尖 → 向上竖线 → 顶部左拐 → end左上
    - O：start左上 → 逆时针绕圆 → end右上
    - B：start底部竖线底端 → 向上竖线 → 上半圈 → 下半圈 → end中间偏右
    - !：start底部点右端 → 向左画点 → 向上竖线 → end顶端
    """
    std_trajs = {}
    total_points = 30  # 固定30个点，和你之前的要求完全一致

    # ===================== 1. J 字符（100%匹配你的手绘）=====================
    # start(22, 10) → 向上竖线 → 顶部左拐并轻微向下 → end(10, 48)
    J_x = np.concatenate([
        np.linspace(22, 22, 15),  # 向上竖线（15个点）
        np.linspace(22, 10, 8),   # 顶部左拐（8个点）
        np.linspace(10, 8, 4),    # 向左下勾（x继续左，y下降）
        np.linspace(8, 12, 3)     # 微向右收（小勾收尾）
    ]).tolist()
    J_y = np.concatenate([
        np.linspace(10, 55, 15),  # 向上竖线
        np.linspace(55, 55, 8),   # 顶部左拐（y固定）
        np.linspace(55, 48, 4),   # 向左下勾（y下降）
        np.linspace(48, 50, 3)     # 微向右收（y微调）
    ]).tolist()
    std_trajs['J'] = [round(x,1) for x in J_x] + [round(y,1) for y in J_y]

    # ===================== 2. O 字符（100%匹配你的手绘）=====================
    # start左上 → 逆时针绕椭圆 → end右上
    cx, cy = 32, 32  # 圆心
    rx, ry = 20, 22  # 椭圆半径，匹配你的手写形状
    # 角度：从135°(左上start) 逆时针转360° 到45°(右上end)，30个点
    theta = np.linspace(3*np.pi/4, 3*np.pi/4 + 2*np.pi, total_points)
    O_x = (cx + rx * np.cos(theta)).tolist()
    O_y = (cy + ry * np.sin(theta)).tolist()
    std_trajs['O'] = [round(x,1) for x in O_x] + [round(y,1) for y in O_y]

    # ===================== 3. B 字符（修复收尾：更平滑的下半圈+自然结束）=====================
    # start(20, 10) → 向上竖线 → 上半圈 → 回竖线 → 下半圈 → end(36, 24)
    B_x = np.concatenate([
        np.linspace(20, 20, 8),   # 向上竖线
        np.linspace(20, 40, 6),   # 上半圈右拐
        np.linspace(40, 20, 4),   # 上半圈回竖线
        np.linspace(20, 40, 7),   # 下半圈右拐
        np.linspace(40, 22, 5)    # 【优化】收尾往start(20,10)靠拢（x从40→22）
    ]).tolist()
    B_y = np.concatenate([
        np.linspace(10, 58, 8),   # 向上竖线
        np.linspace(58, 35, 6),   # 上半圈向下
        np.linspace(35, 35, 4),   # 上半圈回竖线
        np.linspace(35, 18, 7),   # 下半圈向下
        np.linspace(18, 12, 5)     # 【优化】收尾往start(20,10)靠拢（y从18→12）
    ]).tolist()
    std_trajs['B'] = [round(x,1) for x in B_x] + [round(y,1) for y in B_y]

    # ===================== 4. ! 感叹号（100%匹配你的手绘）=====================
    # start(35, 10) 底部右端 → 向左画点 → 向上竖线 → end(30, 58)
    ex_x = np.concatenate([
        np.linspace(35, 25, 5),   # 向左画底部的点
        np.linspace(30, 30, 25)   # 向上竖线，x固定
    ]).tolist()
    ex_y = np.concatenate([
        np.linspace(10, 10, 5),   # 底部点，y固定
        np.linspace(10, 58, 25)   # 向上竖线，y从下到上
    ]).tolist()
    std_trajs['!'] = [round(x,1) for x in ex_x] + [round(y,1) for y in ex_y]

    return std_trajs

# 生成轨迹，验证起终点
custom_trajs = get_custom_standard_trajectories()
for cls in ['J','O','B','!']:
    coords = custom_trajs[cls]
    x, y = coords[:30], coords[30:]
    print(f"{cls} | start起点：({x[0]}, {y[0]}) | end终点：({x[-1]}, {y[-1]})")




# 加载你原有的CSV（只保留文件名、类别、独热编码，坐标全替换成自定义标准轨迹）
# 这里替换成你原CSV的路径
original_csv_path = "/home/oem/py/p_train/train/new.csv"
df = pd.read_csv(original_csv_path, encoding='utf-8-sig')

# 生成完美训练CSV
perfect_csv_data = []
for idx, row in df.iterrows():
    cls = row['类别']
    std_coords = custom_trajs[cls]
    new_row = {
        "文件名": row['文件名'],
        "类别": cls,
        "独热编码": row['独热编码']
    }
    # 填充x1-x30、y1-y30
    for i in range(30):
        new_row[f'x{i+1}'] = std_coords[i]
        new_row[f'y{i+1}'] = std_coords[i+30]
    perfect_csv_data.append(new_row)

# 保存CSV，用于训练
perfect_df = pd.DataFrame(perfect_csv_data)
perfect_csv_path = "./handwriting_custom_standard.csv"
perfect_df.to_csv(perfect_csv_path, index=False, encoding='utf-8-sig')
print(f"✅ 自定义标准轨迹CSV已保存到：{perfect_csv_path}")



# 可视化验证每个字符
CLASSES = ['J','O','B','!']
plt.figure(figsize=(16, 4))

for i, cls in enumerate(CLASSES):
    coords = custom_trajs[cls]
    x = coords[:30]
    y = coords[30:]
    
    plt.subplot(1, 4, i+1)
    # 画轨迹线
    plt.plot(x, y, 'r-', linewidth=3, label=f'{cls} 轨迹')
    # 画点，颜色渐变：start(0)→end(29)
    scatter = plt.scatter(x, y, c=range(30), cmap='viridis', s=50)
    # 标注start和end
    plt.text(x[0], y[0], 'start', fontsize=12, color='orange', fontweight='bold')
    plt.text(x[-1], y[-1], 'end', fontsize=12, color='orange', fontweight='bold')
    
    plt.title(f'{cls} 自定义标准轨迹', fontsize=14)
    plt.xlim(0, 64)
    plt.ylim(0, 64)
    plt.grid(True)
    plt.axis('equal')
    plt.legend()

plt.colorbar(scatter, label='落笔顺序（0=start，29=end）')
plt.tight_layout()
plt.show()



### 保存
import tensorflow as tf
from tensorflow import keras

# 加载原模型
model = keras.models.load_model("./contour_model.h5")

# 纯净转换，关闭所有优化，避免精度损失
converter = tf.lite.TFLiteConverter.from_keras_model(model)
tflite_model = converter.convert()

# 保存新模型
with open("./contour.tflite", "wb") as f:
    f.write(tflite_model)

print("✅ 纯净版TFLite已保存，用这个文件重新跑推理！")
